@using System.Globalization

<svg class="@CssClasses"
     x="@Coordinate(X)"
     y="@Coordinate(Y)"
     width="@Size"
     height="@Size"
     viewBox="-16 -16 32 32"
     preserveAspectRatio="xMidYMid meet"
     role="@AccessibleRole"
     aria-label="@Title"
     aria-hidden="@AriaHidden"
     focusable="false">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <title>@Title</title>
    }
    <g stroke="@Ink" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        @switch (Kind)
        {
            case PowerUpKind.BombCapacity:
                <circle cx="1" cy="3" r="9" fill="@Light" />
                <path d="M 5 -5 Q 7 -12 12 -10" fill="none" />
                <circle cx="12" cy="-10" r="2.4" fill="@Color" stroke="@Light" />
                <circle cx="-8" cy="-7" r="4" fill="@Color" />
                <path d="M -10 -7 H -6 M -8 -9 V -5" fill="none" stroke="@Light" stroke-width="1.8" />
                break;

            case PowerUpKind.FireRange:
                <path d="M 0 14 C -11 11 -12 2 -5 -5 C -2 -8 -3 -12 1 -15 C 2 -8 9 -7 10 1 C 13 9 7 14 0 14 Z" fill="@Light" />
                <path d="M 1 11 C -4 9 -4 4 0 -1 C 1 4 6 5 5 9 C 4 11 2 12 1 11 Z" fill="@Color" stroke="none" />
                break;

            case PowerUpKind.Speed:
                <path d="M -12 5 L -5 4 L -1 -6 H 7 L 5 0 L 12 4 L 9 9 H -5 Z" fill="@Light" />
                <path d="M -13 -5 H -4 M -15 0 H -6" fill="none" stroke="@Soft" stroke-width="2.5" />
                <path d="M -14 11 H 8" fill="none" stroke="@Color" stroke-width="2.5" />
                <path d="M 2 -14 H 10 L 5 -8 H 10 L -1 1 L 2 -6 H -3 Z" fill="@Color" />
                break;

            case PowerUpKind.Kick:
                <path d="M -11 -11 H -2 L 0 -1 L 10 3 L 12 9 L 7 12 L -8 10 L -12 5 Z" fill="@Light" />
                <path d="M -8 7 L 8 9" fill="none" stroke="@Color" stroke-width="3" />
                <path d="M 12 -5 L 15 -8 M 13 0 H 16 M 12 5 L 15 8" fill="none" stroke="@Light" />
                break;

            case PowerUpKind.Glove:
                <circle cx="-7" cy="-5" r="5" fill="@Light" />
                <circle cx="0" cy="-8" r="5" fill="@Light" />
                <circle cx="7" cy="-5" r="5" fill="@Light" />
                <path d="M -11 -3 L -9 7 Q -6 13 1 12 L 8 8 Q 12 3 8 -1 L 3 3 L -2 0 Z" fill="@Light" />
                <path d="M -6 9 L 6 8 L 7 14 L -5 14 Z" fill="@Color" />
                break;

            case PowerUpKind.Remote:
                <rect x="-9" y="-10" width="18" height="23" rx="4" fill="@Light" />
                <path d="M 3 -10 L 9 -15" fill="none" />
                <circle cx="9" cy="-15" r="1.8" fill="@Color" />
                <circle cx="-4" cy="-4" r="2.5" fill="@Color" />
                <circle cx="4" cy="3" r="2.5" fill="@Ink" stroke="none" />
                <path d="M -5 7 H 5" fill="none" />
                <path d="M 11 -12 A 5 5 0 0 1 15 -6" fill="none" stroke="@Light" />
                break;

            case PowerUpKind.Pierce:
                <path d="M -14 -9 H -6 V -2 H -14 Z M -14 3 H -6 V 10 H -14 Z M 14 -9 H 6 V -2 H 14 Z M 14 3 H 6 V 10 H 14 Z" fill="@Soft" />
                <path d="M -13 0 H 9" fill="none" stroke="@Light" stroke-width="3" />
                <path d="M 8 -5 L 15 0 L 8 5 Z" fill="@Color" />
                break;

            case PowerUpKind.BombPass:
                <circle cx="-7" cy="6" r="6" fill="@Soft" />
                <path d="M -2 -11 Q 7 -14 10 -5 V 10 L 6 7 L 2 10 L -2 7 L -6 10 V -5 Q -5 -9 -2 -11 Z" fill="@Light" />
                <circle cx="-1" cy="-4" r="1.5" fill="@Ink" stroke="none" />
                <circle cx="5" cy="-4" r="1.5" fill="@Ink" stroke="none" />
                <path d="M -13 13 L 13 -13" fill="none" stroke="@Color" stroke-width="2.5" />
                break;

            case PowerUpKind.WallPass:
                <path d="M -12 -14 H -5 V -7 H -12 Z M 7 -14 H 14 V -7 H 7 Z M -12 -4 H -5 V 3 H -12 Z M 7 -4 H 14 V 3 H 7 Z M -12 6 H -5 V 13 H -12 Z M 7 6 H 14 V 13 H 7 Z" fill="@Soft" />
                <path d="M -4 -10 Q 2 -14 6 -8 V 9 L 2 6 L -2 9 L -5 6 V -7 Q -5 -9 -4 -10 Z" fill="@Light" />
                <circle cx="-1" cy="-4" r="1.2" fill="@Ink" stroke="none" />
                <circle cx="3" cy="-4" r="1.2" fill="@Ink" stroke="none" />
                <path d="M -14 15 L 14 -15" fill="none" stroke="@Color" stroke-width="2.5" />
                break;

            case PowerUpKind.FlamePass:
                <path d="M 0 -15 L 12 -10 L 10 3 L 6 10 L 0 14 L -6 10 L -10 3 L -12 -10 Z" fill="@Light" />
                <path d="M 0 9 C -6 7 -6 1 -2 -3 Q 0 -6 1 -10 Q 8 -3 5 5 Q 4 9 0 9 Z" fill="@Color" />
                break;

            case PowerUpKind.Shield:
                <path d="M 0 -15 L 12 -10 L 10 4 L 5 11 L 0 15 L -5 11 L -10 4 L -12 -10 Z" fill="@Light" />
                <path d="M 0 -9 L 6 -6 L 5 3 L 0 9 L -5 3 L -6 -6 Z" fill="@Color" stroke="none" />
                <path d="M -5 -13 L -9 -9 M -8 -13 L -5 -10" fill="none" stroke="@Light" />
                break;

            case PowerUpKind.Heart:
                <path d="M 0 14 C -3 10 -13 4 -13 -4 C -13 -13 -3 -15 0 -8 C 4 -15 13 -13 13 -4 C 13 4 3 11 0 14 Z" fill="@Light" />
                <path d="M -8 1 H -4 L -1 -4 L 3 6 L 6 1 H 10" fill="none" stroke="@Color" stroke-width="2.5" />
                break;

            case PowerUpKind.Dash:
                <path d="M 1 -15 H 12 L 5 -5 H 12 L -3 15 L 0 2 H -8 Z" fill="@Color" />
                <path d="M -14 -8 H -5 M -16 0 H -7 M -14 8 H -5" fill="none" stroke="@Light" stroke-width="2.5" />
                break;

            case PowerUpKind.Mega:
                <circle cx="0" cy="2" r="8" fill="@Light" />
                <path d="M 4 -5 Q 7 -11 11 -9" fill="none" />
                <g fill="none" stroke-width="2">
                    <path d="M 11 2 H 15 M -11 2 H -15 M 0 -9 V -13 M 0 13 V 17" stroke="@Color" />
                    <path d="M 8 -6 L 11 -9 M -8 -6 L -11 -9 M 8 10 L 11 13 M -8 10 L -11 13" stroke="@Light" />
                </g>
                <circle cx="11" cy="-9" r="2" fill="@Color" stroke="@Light" />
                break;

            case PowerUpKind.Cluster:
                <path d="M 0 0 L -9 -8 M 0 0 L 9 -8 M 0 0 L -9 9 M 0 0 L 9 9" fill="none" stroke="@Soft" />
                <circle cx="-9" cy="-8" r="4" fill="@Color" />
                <circle cx="9" cy="-8" r="4" fill="@Color" />
                <circle cx="-9" cy="9" r="4" fill="@Color" />
                <circle cx="9" cy="9" r="4" fill="@Color" />
                <circle cx="0" cy="0" r="6" fill="@Light" />
                <circle cx="0" cy="0" r="2" fill="@Color" stroke="none" />
                break;

            case PowerUpKind.Freeze:
                <g fill="none">
                    <path d="M -14 0 H 14 M 9 0 L 5 -4 M 9 0 L 5 4 M -9 0 L -5 -4 M -9 0 L -5 4" stroke="@Light" stroke-width="2.4" />
                    <path d="M -14 0 H 14 M 9 0 L 5 -4 M 9 0 L 5 4 M -9 0 L -5 -4 M -9 0 L -5 4" stroke="@Color" transform="rotate(60)" />
                    <path d="M -14 0 H 14 M 9 0 L 5 -4 M 9 0 L 5 4 M -9 0 L -5 -4 M -9 0 L -5 4" stroke="@Light" transform="rotate(120)" />
                </g>
                <circle cx="0" cy="0" r="2.5" fill="@Light" />
                break;

            case PowerUpKind.Magnet:
                <path d="M 11 -1 A 11 11 0 0 1 -11 -1 L -4 -1 A 4 4 0 0 0 4 -1 Z" fill="@Light" />
                <path d="M -11 -2 H -4 V 9 H -11 Z M 4 -2 H 11 V 9 H 4 Z" fill="@Color" />
                <path d="M -10 12 H -4 M 4 12 H 10" fill="none" stroke="@Light" />
                break;

            case PowerUpKind.Mystery:
                <rect x="-12" y="-7" width="24" height="19" rx="3" fill="@Light" />
                <path d="M -14 -11 H 14 V -4 H -14 Z" fill="@Color" />
                <path d="M -2 -11 H 2 V 12 H -2 Z" fill="@Soft" />
                <ellipse cx="-5" cy="-14" rx="6" ry="3" transform="rotate(-26 -5 -14)" fill="@Light" />
                <ellipse cx="5" cy="-14" rx="6" ry="3" transform="rotate(26 5 -14)" fill="@Light" />
                <path d="M 12 -15 H 15 M 13.5 -17 V -13" fill="none" stroke="@Color" />
                break;
        }
    </g>
</svg>

@code {
    private const string Ink = "#06101d";
    private const string Light = "#f4ffff";
    private const string Soft = "#bce8f0";

    [Parameter, EditorRequired]
    public PowerUpKind Kind { get; set; }

    [Parameter]
    public string Color { get; set; } = "#67f6ff";

    [Parameter]
    public int Size { get; set; } = 32;

    [Parameter]
    public double X { get; set; }

    [Parameter]
    public double Y { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Title { get; set; }

    private string CssClasses => string.IsNullOrWhiteSpace(Class) ? "power-up-icon" : $"power-up-icon {Class}";

    private string? AccessibleRole => string.IsNullOrWhiteSpace(Title) ? null : "img";

    private string? AriaHidden => string.IsNullOrWhiteSpace(Title) ? "true" : null;

    private static string Coordinate(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
}
