@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="shell">
    <header class="topbar">
        <div class="brand">
            <img src="assets/icons/icon-192.png" alt="霓虹爆彈王圖示" />
            <div class="brand-copy">
                <strong>霓虹爆彈王</strong>
                <span>.NET Edition</span>
            </div>
            <span class="net-badge">C# · WebAssembly</span>
        </div>
        <div class="top-actions">
            <button class="ghost-button help-button" @onclick="ShowHelp">玩法與晶片</button>
            @if (_inLobby)
            {
                <button type="button"
                        class="exit-button"
                        aria-label="離開霓虹爆彈王"
                        aria-busy="@_isExiting"
                        disabled="@(_isExiting || !_settingsLoaded)"
                        @onclick="RequestExitAsync">
                    <span class="exit-button-icon" aria-hidden="true">⏻</span>
                    <span>@(_isExiting ? "正在離開…" : "離開遊戲")</span>
                </button>
            }
            @if (!_inLobby)
            {
                <span class="status-pill">第 @_snapshot.RoundNumber 回合</span>
                <button class="icon-button" @onclick="TogglePause">@(_snapshot.Phase == GamePhase.Paused ? "繼續" : "暫停")</button>
            }
        </div>
    </header>

    @if (_inLobby)
    {
        <main class="lobby">
            <section class="hero" aria-labelledby="game-title">
                <div class="hero-art">
                    <img src="assets/icons/app-icon.png" alt="帶有霓虹軌道的未來爆彈" />
                </div>
                <div class="eyebrow">Deterministic arena protocol</div>
                <h1 id="game-title">霓虹<span>爆彈王</span></h1>
                <p>在會改變的迷宮中佈雷、破箱、搶晶片。整套競技規則、人工智慧與爆炸模擬都在瀏覽器裡由 C# 執行。</p>
                <div class="tech-row" aria-label="技術特色">
                    <span class="chance-pill">Blazor WebAssembly</span>
                    <span class="chance-pill">60 Hz C# 模擬</span>
                    <span class="chance-pill">2–4 位參賽者</span>
                </div>
            </section>

            <section class="setup-panel" aria-labelledby="setup-title">
                <div class="section-heading">
                    <div>
                        <h2 id="setup-title">組建競技陣容</h2>
                        <p>選擇真人或 AI；關閉的席位不會加入比賽。</p>
                    </div>
                    <div class="setup-status">
                        <span class="chance-pill">@EnabledSlotCount / 4</span>
                        <span class="settings-save-state @(_settingsStorageAvailable ? null : "unavailable")">
                            @SettingsPersistenceText
                        </span>
                    </div>
                </div>

                <div class="player-grid">
                    @for (var i = 0; i < _slots.Count; i++)
                    {
                        var slot = _slots[i];
                        <article class="player-card @(slot.Mode == SlotMode.Off ? "disabled" : null)" style="@PlayerStyle(slot.Color)">
                            <div class="player-label">SLOT @(i + 1)</div>
                            <input aria-label="玩家 @(i + 1) 名稱" maxlength="16" @bind="slot.Name" @bind:event="oninput" @bind:after="SaveLobbySettingsAsync" disabled="@(slot.Mode == SlotMode.Off)" />
                            <select aria-label="玩家 @(i + 1) 類型" @bind="slot.Mode" @bind:after="SaveLobbySettingsAsync">
                                <option value="@SlotMode.Human">真人操控</option>
                                <option value="@SlotMode.Computer">人工智慧</option>
                                <option value="@SlotMode.Off">關閉席位</option>
                            </select>
                            @if (slot.Mode == SlotMode.Computer)
                            {
                                <select aria-label="玩家 @(i + 1) AI 難度" @bind="slot.Difficulty" @bind:after="SaveLobbySettingsAsync">
                                    <option value="@AiDifficulty.Novice">新手 AI</option>
                                    <option value="@AiDifficulty.Standard">標準 AI</option>
                                    <option value="@AiDifficulty.Expert">高手 AI</option>
                                </select>
                            }
                        </article>
                    }
                </div>

                <div class="settings-row">
                    <label class="setting">
                        <span>勝利皇冠</span>
                        <select @bind="_targetCrowns" @bind:after="SaveLobbySettingsAsync">
                            <option value="1">1 冠</option>
                            <option value="2">2 冠</option>
                            <option value="3">3 冠</option>
                            <option value="5">5 冠</option>
                        </select>
                    </label>
                    <label class="setting">
                        <span>能量箱密度</span>
                        <select @bind="_crateDensity" @bind:after="SaveLobbySettingsAsync">
                            <option value="0.46">寬闊</option>
                            <option value="0.6">標準</option>
                            <option value="0.72">瘋狂</option>
                        </select>
                    </label>
                    <label class="setting">
                        <span>晶片掉落率</span>
                        <select @bind="_itemDropChance" @bind:after="SaveLobbySettingsAsync">
                            <option value="0.30">稀少</option>
                            <option value="0.52">豐富</option>
                            <option value="0.76">暴雨</option>
                        </select>
                    </label>
                </div>

                <div class="rarity-note">
                    <div class="rarity-icons" aria-hidden="true">
                        <i style="--chip:#ffdb54"><PowerUpIcon Kind="@PowerUpKind.BombCapacity" Color="#ffdb54" Size="23" /></i>
                        <i style="--chip:#ff653d"><PowerUpIcon Kind="@PowerUpKind.FireRange" Color="#ff653d" Size="23" /></i>
                    </div>
                    <span>爆彈容量與烈焰範圍各有 <strong>@PriorityDropPercent</strong> 的晶片權重，單項皆為其他晶片最高權重的 3 倍。</span>
                </div>

                @if (!CanStart)
                {
                    <p role="alert" style="margin:.15rem 0 .65rem;color:#ff93aa;font-size:.76rem">至少啟用兩個席位。</p>
                }
                <button class="primary-button" disabled="@(!CanStart || !_settingsLoaded)" @onclick="StartMatchAsync">啟動 .NET 競技場</button>
            </section>
        </main>
    }
    else
    {
        <main class="arena-layout">
            <section class="board-card">
                <div class="board-toolbar">
                    <div class="round-copy">第 @_snapshot.RoundNumber 回合 <span>先取得 @_snapshot.TargetCrowns 冠者勝出</span></div>
                    <div class="board-help"><span class="preview-legend"></span>虛線預示爆風 · 點擊競技場後使用鍵盤 · <kbd>Esc</kbd> 暫停</div>
                </div>
                <div class="arena-focus" tabindex="0" @ref="_arenaFocus" @onkeydown="OnKeyDown" @onkeyup="OnKeyUp" @onkeydown:preventDefault="true" @onkeyup:preventDefault="true">
                    <svg class="arena-svg" viewBox="0 0 816 624" role="img" aria-label="17 乘 13 格爆彈競技場">
                        <defs>
                            <linearGradient id="wallGradient" x1="0" y1="0" x2="1" y2="1">
                                <stop offset="0" stop-color="#1a3155" />
                                <stop offset=".5" stop-color="#11213d" />
                                <stop offset="1" stop-color="#080e22" />
                            </linearGradient>
                            <linearGradient id="crateGradient" x1="0" y1="0" x2="1" y2="1">
                                <stop offset="0" stop-color="#55306f" />
                                <stop offset=".52" stop-color="#281c48" />
                                <stop offset="1" stop-color="#120f2c" />
                            </linearGradient>
                            <radialGradient id="bombGradient" cx="35%" cy="28%">
                                <stop offset="0" stop-color="#eefcff" />
                                <stop offset=".18" stop-color="#4ac9df" />
                                <stop offset=".46" stop-color="#263759" />
                                <stop offset="1" stop-color="#030611" />
                            </radialGradient>
                            <radialGradient id="ghostBombGradient" cx="35%" cy="28%">
                                <stop offset="0" stop-color="#ffffff" />
                                <stop offset=".2" stop-color="#ddcaff" />
                                <stop offset=".55" stop-color="#493b70" />
                                <stop offset="1" stop-color="#070513" />
                            </radialGradient>
                            <radialGradient id="flameGradient">
                                <stop offset="0" stop-color="#fff" />
                                <stop offset=".22" stop-color="#fff078" />
                                <stop offset=".55" stop-color="#ff682e" />
                                <stop offset="1" stop-color="#ff2f8d" stop-opacity=".2" />
                            </radialGradient>
                            <filter id="hotGlow"><feGaussianBlur stdDeviation="4" result="blur" /><feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
                            <filter id="playerGlow"><feGaussianBlur stdDeviation="3" result="blur" /><feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
                        </defs>

                        <ArenaBoardLayer Board="_snapshot.Board" CellSize="CellSize" />

                        <g class="ghost-rail" aria-hidden="true">
                            <rect class="ghost-rail-accent" x="20" y="20" width="776" height="584" rx="5" />
                            <rect class="ghost-rail-main" x="24" y="24" width="768" height="576" rx="2" />
                        </g>

                        @foreach (var ghost in _snapshot.Players.Where(player => player.IsGhost && player.IsGhostBombReady))
                        {
                            <g @key="@($"ghost-targets:{ghost.Id}")" class="ghost-targets" style="@PlayerStyle(ghost.Color)" aria-hidden="true">
                                @foreach (var cell in GhostLandingCells(ghost))
                                {
                                    <g @key="@($"ghost-target:{ghost.Id}:{cell.X}:{cell.Y}")" transform="@CellTransform(cell)">
                                        <circle class="ghost-target-ring" r="7" />
                                        <path class="ghost-target-cross" d="M-10 0 H10 M0 -10 V10" />
                                        <circle class="ghost-target-core" r="2.2" />
                                    </g>
                                }
                            </g>
                        }

                        @* Every keyed arena entity is a direct child of this SVG. Keep
                           type prefixes because bomb and item IDs use independent counters. *@
                        @foreach (var bomb in _snapshot.Bombs)
                        {
                            @if (!bomb.IsAirborne)
                            {
                                var previewColor = bomb.IsMega ? "#ffd45c" : bomb.IsGhost ? "#d9b9ff" : PlayerColor(bomb.OwnerPlayerId);
                                <g @key="@($"preview:{bomb.Id}")" class="blast-preview @(bomb.IsGhost ? "ghost-preview" : null)" aria-hidden="true">
                                    @foreach (var cell in bomb.FlamePreviewCells)
                                    {
                                        <rect class="blast-preview-cell @(cell == bomb.Cell ? "origin" : null)"
                                              x="@(cell.X * CellSize + 7)"
                                              y="@(cell.Y * CellSize + 7)"
                                              width="@(CellSize - 14)"
                                              height="@(CellSize - 14)"
                                              rx="11"
                                              fill="@previewColor"
                                              stroke="@previewColor" />
                                    }
                                </g>
                            }
                        }

                        @foreach (var item in _snapshot.Items)
                        {
                            <g @key="@($"item:{item.Id}")" transform="@ItemTransform(item)">
                                <circle class="item-halo" r="18" fill="@item.Color" />
                                <rect class="item-core" x="-13" y="-13" width="26" height="26" rx="7" stroke="@item.Color" />
                                <PowerUpIcon Kind="@item.Kind" Color="@item.Color" Size="25" X="@(-12.5)" Y="@(-12.5)" />
                            </g>
                        }

                        @foreach (var flame in _snapshot.Flames)
                        {
                            <rect @key="@($"flame:{flame.Cell.X}:{flame.Cell.Y}:{flame.SourceBombId}")" class="flame" x="@(flame.Cell.X * CellSize + 4)" y="@(flame.Cell.Y * CellSize + 4)" width="@(CellSize - 8)" height="@(CellSize - 8)" rx="15" />
                        }

                        @foreach (var bomb in _snapshot.Bombs)
                        {
                            var ownerColor = PlayerColor(bomb.OwnerPlayerId);
                            var bombStroke = bomb.IsGhost ? "#ead8ff" : ownerColor;
                            <g @key="@($"bomb:{bomb.Id}")" transform="@BombTransform(bomb)" style="@PlayerStyle(ownerColor)">
                                <g class="bomb-entity @(bomb.IsGhost ? "ghost-bomb" : null) @(bomb.IsAirborne ? "airborne" : null)">
                                    @if (bomb.IsBrickDisguised && !bomb.IsGhost)
                                    {
                                        <g class="brick-bomb-disguise" aria-hidden="true">
                                            <rect class="crate-cell" x="-20" y="-20" width="40" height="40" rx="7" />
                                            <path class="crate-line" d="M-12 -12 L12 12 M12 -12 L-12 12" />
                                        </g>
                                    }
                                    else
                                    {
                                        @if (bomb.IsAirborne)
                                        {
                                            <circle class="ghost-flight-aura" r="26" />
                                            <circle class="ghost-flight-spark spark-one" cx="-25" cy="6" r="3" />
                                            <circle class="ghost-flight-spark spark-two" cx="-35" cy="-7" r="2" />
                                        }
                                        <circle class="bomb-shell" r="15" stroke="@bombStroke" />
                                        <circle class="fuse-ring" r="19" pathLength="100" stroke="@bombStroke" stroke-dasharray="100" stroke-dashoffset="@BombDashOffset(bomb)" />
                                        <path d="M7 -12 Q10 -23 17 -18" fill="none" stroke="#d9f7ff" stroke-width="3" stroke-linecap="round" />
                                        <circle class="bomb-fuse" cx="18" cy="-19" r="4" />
                                        @if (bomb.IsGhost)
                                        {
                                            <circle class="ghost-bomb-ring" r="24" />
                                        }
                                        @if (bomb.IsMega)
                                        {
                                            <circle r="23" fill="none" stroke="#ffd45c" stroke-width="2" stroke-dasharray="3 4" />
                                        }
                                    }
                                </g>
                            </g>
                        }

                        @foreach (var player in _snapshot.Players)
                        {
                            <g @key="@($"player:{player.Id}")"
                               class="player @(player.IsGhost ? "ghost" : !player.IsAlive ? "dead" : "living")"
                               transform="@PlayerTransform(player)"
                               style="@PlayerStyle(player.Color)">
                                @if (player.IsGhost)
                                {
                                    <g class="ghost-avatar">
                                        <path class="ghost-body"
                                              d="M-17 7 C-19 -12 -11 -22 0 -23 C13 -22 20 -11 17 8 L15 22 L8 16 L1 23 L-7 16 L-15 22 Z"
                                              fill="@player.Color"
                                              filter="url(#playerGlow)" />
                                        <path class="ghost-body-shine" d="M-10 3 C-12 -10 -7 -17 1 -18 C8 -17 12 -9 10 3" />
                                        <ellipse class="ghost-eye" cx="@(-6 + player.FacingX * 3)" cy="@(-5 + player.FacingY * 3)" rx="3.2" ry="5" />
                                        <ellipse class="ghost-eye" cx="@(6 + player.FacingX * 3)" cy="@(-5 + player.FacingY * 3)" rx="3.2" ry="5" />
                                        <circle class="ghost-eye-glint" cx="@(-5 + player.FacingX * 3)" cy="@(-7 + player.FacingY * 3)" r="1.2" />
                                        <circle class="ghost-eye-glint" cx="@(7 + player.FacingX * 3)" cy="@(-7 + player.FacingY * 3)" r="1.2" />
                                        <path class="ghost-direction" d="@GhostDirectionPath(player)" />
                                        @if (player.IsGhostBombReady)
                                        {
                                            <g class="ghost-ready-orbit">
                                                <circle class="ghost-orbit-guide" r="30" />
                                                <circle class="ghost-ready-shell" cx="24" cy="0" r="6" />
                                                <path class="ghost-ready-fuse" d="M26 -5 Q29 -11 33 -8" />
                                            </g>
                                        }
                                    </g>
                                }
                                else
                                {
                                    <ellipse class="player-shadow" cx="0" cy="14" rx="15" ry="6" />
                                    <rect class="player-body" x="-14" y="-16" width="28" height="31" rx="11" fill="@player.Color" filter="url(#playerGlow)" />
                                    <rect class="player-visor" x="-10" y="-11" width="20" height="9" rx="4" />
                                    <rect x="-11" y="4" width="22" height="4" rx="2" fill="#071225" />
                                    @if (player.Shield > 0)
                                    {
                                        <circle class="shield-ring" r="23" />
                                    }
                                }
                                <text class="player-name @(player.IsGhost ? "ghost-name" : null)" y="@(player.IsGhost ? -31 : -23)">@player.Name</text>
                            </g>
                        }
                    </svg>

                    @if (_snapshot.Phase == GamePhase.Paused)
                    {
                        <div class="overlay">
                            <div class="dialog">
                                <img src="assets/icons/icon-192.png" alt="" />
                                <span class="eyebrow">Simulation suspended</span>
                                <h2>競技場暫停</h2>
                                <p>C# 模擬已凍結；目前爆彈倒數、火焰和 AI 都不會前進。</p>
                                <div class="dialog-actions">
                                    <button class="primary-button" @onclick="ResumeAsync">繼續戰鬥</button>
                                    <button class="ghost-button" @onclick="ReturnToLobby">返回大廳</button>
                                </div>
                            </div>
                        </div>
                    }
                    else if (_snapshot.Phase is GamePhase.RoundOver or GamePhase.MatchOver)
                    {
                        var winner = RoundWinner;
                        <div class="overlay">
                            <div class="dialog">
                                <img src="assets/icons/icon-192.png" alt="" />
                                <span class="eyebrow">@(_snapshot.Phase == GamePhase.MatchOver ? "Match complete" : "Round complete")</span>
                                <h2 style="color:@(winner?.Color ?? "#f5f8ff")">@(winner is null ? "同歸於盡！" : $"{winner.Name} 存活！")</h2>
                                <p>@RoundSummary</p>
                                <div class="dialog-actions">
                                    @if (_snapshot.Phase == GamePhase.RoundOver)
                                    {
                                        <button class="primary-button" @onclick="NextRoundAsync">下一回合</button>
                                    }
                                    <button class="ghost-button" @onclick="ReturnToLobby">返回大廳</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>

            <aside class="hud-panel" aria-label="參賽者狀態">
                <div class="hud-heading"><h2>LIVE TELEMETRY</h2><span>@_snapshot.ElapsedSeconds.ToString("0.0") s</span></div>
                <div class="hud-list">
                    @foreach (var player in _snapshot.Players)
                    {
                        <article class="hud-card @(player.IsGhost ? "ghost" : !player.IsAlive ? "dead" : null)"
                                 style="@PlayerStyle(player.Color)"
                                 data-player-id="@player.Id"
                                 data-bombs-placed="@player.Statistics.BombsPlaced"
                                 data-crates-destroyed="@player.Statistics.CratesDestroyed">
                            <div class="hud-name"><strong>@player.Name</strong><span class="crowns">@(player.Crowns == 0 ? "—" : new string('♛', player.Crowns))</span></div>
                            <div class="hud-subtitle">@PlayerStatus(player)</div>
                            <div class="stat-grid">
                                @if (player.IsGhost)
                                {
                                    <div class="stat ghost-stat"><b>外圈</b><span>soul</span></div>
                                    <div class="stat ghost-stat"><b>@GhostBombShortStatus(player)</b><span>bomb</span></div>
                                    <div class="stat ghost-stat"><b>@FacingArrow(player)</b><span>aim</span></div>
                                    <div class="stat ghost-stat"><b>@player.Statistics.Revivals</b><span>revive</span></div>
                                }
                                else
                                {
                                    <div class="stat"><b>@player.BombsAvailable/@player.BombCapacity</b><span>bomb</span></div>
                                    <div class="stat"><b>@player.FireRange</b><span>range</span></div>
                                    <div class="stat"><b>@player.MoveSpeed.ToString("0.0")</b><span>speed</span></div>
                                    <div class="stat"><b>@(player.Health > 0 ? new string('♥', player.Health) : "×")</b><span>life</span></div>
                                }
                            </div>
                            <div class="power-strip">
                                @foreach (var power in ActivePowers(player))
                                {
                                    <span class="power-dot" style="@ChipStyle(power.Color)" title="@power.Name">
                                        <PowerUpIcon Kind="@power.Kind" Color="@power.Color" Size="17" Title="@power.Name" />
                                    </span>
                                }
                            </div>
                        </article>
                    }
                </div>
                <div class="control-hint">
                    <strong>真人 1</strong>　<kbd>WASD</kbd> 移動　<kbd>Q</kbd> 爆彈　<kbd>E</kbd> 技能<br />
                    <strong>真人 2</strong>　<kbd>UHJK</kbd> 移動　<kbd>Y</kbd> 爆彈　<kbd>I</kbd> 技能<br />
                    <strong>真人 3</strong>　<kbd>方向鍵</kbd> 移動　<kbd>PgUp</kbd> 爆彈<br />
                    <strong>真人 4</strong>　<kbd>數字鍵盤</kbd> 移動　<kbd>0</kbd> 爆彈<br />
                    <strong>幽靈</strong>　沿用移動鍵繞行外圈；面向場內按爆彈鍵投擲
                </div>
            </aside>
        </main>
    }

    @if (_showExitFallback)
    {
        <div class="overlay exit-help-overlay" role="dialog" aria-modal="true" aria-labelledby="exit-help-title" @onclick="HideExitFallback">
            <div class="dialog exit-help-dialog" @onclick:stopPropagation="true">
                <div class="exit-help-icon" aria-hidden="true">⏻</div>
                <span class="eyebrow">Browser safety lock</span>
                <h2 id="exit-help-title">請按 Alt + F4 離開</h2>
                <p>瀏覽器不允許這個分頁自行關閉。按下列快捷鍵即可安全結束；你的主選單設定已經保留。</p>
                <div class="exit-shortcut" aria-label="Alt 加 F4"><kbd>Alt</kbd><span>＋</span><kbd>F4</kbd></div>
                <div class="dialog-actions">
                    <button class="ghost-button" @onclick="HideExitFallback">回到主畫面</button>
                </div>
            </div>
        </div>
    }

    @if (_showHelp)
    {
        <div class="overlay help-overlay" role="dialog" aria-modal="true" aria-labelledby="help-title" @onclick="HideHelp">
            <div class="dialog help-dialog" @onclick:stopPropagation="true">
                <span class="eyebrow">Operator handbook</span>
                <h2 id="help-title">爆彈競技指南</h2>
                <div class="help-grid">
                    <div class="help-block"><b>佈雷與逃生</b><span>一般爆彈約 1.9 秒後爆炸；地面上的彩色虛線會即時標出實際爆風。堅固牆會完全擋火，能量箱則會擋住並吸收最後一格火焰。</span></div>
                    <div class="help-block"><b>連鎖反應</b><span>火焰碰到另一枚爆彈會提前引爆。把對手困在兩條爆炸線的交會處，比盲目追趕有效。</span></div>
                    <div class="help-block"><b>C# 人工智慧</b><span>AI 會評估危險格、尋找逃生路、靠近晶片，並只在有合理退路時嘗試放彈。</span></div>
                    <div class="help-block"><b>幽靈復仇</b><span>出局後會化為幽靈並沿最外圈飄行。面向場內按爆彈鍵可投擲一枚幽靈爆彈；它爆炸後才能再投。若爆風擊倒對手，幽靈會在該處以一顆生命復活；但場內只剩一人時回合會立即結束。</span></div>
                </div>
                <div class="power-catalog">
                    @foreach (var power in PowerUpCatalog.All)
                    {
                        <div class="catalog-item">
                            <div class="catalog-icon" style="@ChipStyle(power.Color)">
                                <PowerUpIcon Kind="@power.Kind" Color="@power.Color" Size="23" Title="@power.Name" />
                            </div>
                            <div class="catalog-copy"><b>@power.Name · W@(power.Weight)</b><span>@power.Description</span></div>
                        </div>
                    }
                </div>
                <p>容量與範圍晶片各占全部晶片權重的 @PriorityDropPercent；兩者合計 @PriorityCombinedDropPercent。</p>
                <div class="dialog-actions"><button class="primary-button" @onclick="HideHelp">了解，準備爆破</button></div>
            </div>
        </div>
    }
</div>

@code {
    private const int CellSize = 48;
    private const int LobbySettingsSchemaVersion = 1;
    private const int MaxLobbySettingsLength = 32 * 1024;
    private const string LobbySettingsStorageKey = "neon-bomber.main-menu.v1";
    private static readonly string[] Colors = ["#35f6ff", "#ff4fa3", "#9dff55", "#ffd34f"];
    private static readonly ControlScheme[] ControlSchemes =
    [
        new("KeyA", "KeyD", "KeyW", "KeyS", "KeyQ", "KeyE"),
        new("KeyH", "KeyK", "KeyU", "KeyJ", "KeyY", "KeyI"),
        new("ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown", "PageUp", "PageDown"),
        new("Numpad4", "Numpad6", "Numpad8", "Numpad5", "Numpad0", "NumpadDecimal")
    ];

    private readonly List<SlotEditor> _slots =
    [
        new("青藍閃電", SlotMode.Human, AiDifficulty.Standard, Colors[0]),
        new("桃紅魅影", SlotMode.Computer, AiDifficulty.Standard, Colors[1]),
        new("翠綠風暴", SlotMode.Computer, AiDifficulty.Expert, Colors[2]),
        new("黃金戰神", SlotMode.Off, AiDifficulty.Standard, Colors[3])
    ];
    private readonly HashSet<string> _heldKeys = new(StringComparer.Ordinal);
    private readonly CancellationTokenSource _loopCancellation = new();
    private readonly System.Diagnostics.Stopwatch _clock = System.Diagnostics.Stopwatch.StartNew();

    private GameSession _session = new();
    private GameSnapshot _snapshot = new GameSession().Snapshot;
    private ElementReference _arenaFocus;
    private Task? _loopTask;
    private bool _inLobby = true;
    private bool _showHelp;
    private bool _showExitFallback;
    private bool _isExiting;
    private bool _focusArenaAfterRender;
    private bool _settingsLoaded;
    private bool _settingsStorageAvailable = true;
    private int _targetCrowns = 3;
    private double _crateDensity = .60;
    private double _itemDropChance = .52;

    private int EnabledSlotCount => _slots.Count(slot => slot.Mode != SlotMode.Off);
    private bool CanStart => EnabledSlotCount >= 2;
    private string SettingsPersistenceText => !_settingsLoaded
        ? "載入設定…"
        : _settingsStorageAvailable
            ? "設定已自動儲存"
            : "本機儲存無法使用";
    private static string PriorityDropPercent => $"{PowerUpCatalog.Get(PowerUpKind.BombCapacity).Weight * 100d / PowerUpCatalog.TotalWeight:0.0}%";
    private static string PriorityCombinedDropPercent => $"{(PowerUpCatalog.Get(PowerUpKind.BombCapacity).Weight + PowerUpCatalog.Get(PowerUpKind.FireRange).Weight) * 100d / PowerUpCatalog.TotalWeight:0.0}%";
    private PlayerSnapshot? RoundWinner => _snapshot.LastRound?.WinnerPlayerId is int id ? _snapshot.Players.FirstOrDefault(player => player.Id == id) : null;
    private string RoundSummary => _snapshot.Phase == GamePhase.MatchOver && RoundWinner is { } champion
        ? $"{champion.Name} 已取得 {_snapshot.TargetCrowns} 頂皇冠，成為本場冠軍。"
        : RoundWinner is { } winner
            ? $"{winner.Name} 取得一頂皇冠；下一回合的晶片與能力會重新洗牌。"
            : "這一回合沒有存活者；無人取得皇冠。";

    protected override void OnInitialized()
    {
        _snapshot = _session.Snapshot;
        _loopTask = RunGameLoopAsync(_loopCancellation.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadLobbySettingsAsync();
            _settingsLoaded = true;
            await InvokeAsync(StateHasChanged);
        }

        if (!_focusArenaAfterRender || _inLobby)
        {
            return;
        }

        _focusArenaAfterRender = false;
        await _arenaFocus.FocusAsync(preventScroll: true);
    }

    private async Task StartMatchAsync()
    {
        if (!CanStart)
        {
            return;
        }

        await SaveLobbySettingsAsync();

        var players = _slots
            .Where(slot => slot.Mode != SlotMode.Off)
            .Select((slot, index) => new PlayerSlotConfiguration
            {
                Name = string.IsNullOrWhiteSpace(slot.Name) ? $"PLAYER {index + 1}" : slot.Name.Trim(),
                Kind = slot.Mode == SlotMode.Human ? PlayerKind.Human : PlayerKind.Computer,
                Difficulty = slot.Difficulty,
                Color = slot.Color
            })
            .ToArray();

        _session = new GameSession(new GameConfiguration
        {
            Seed = unchecked(Environment.TickCount ^ (int)DateTime.UtcNow.Ticks),
            TargetCrowns = _targetCrowns,
            CrateDensity = _crateDensity,
            ItemDropChance = _itemDropChance,
            Players = players
        });
        _session.StartMatch();
        _snapshot = _session.Snapshot;
        _heldKeys.Clear();
        _inLobby = false;
        _focusArenaAfterRender = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadLobbySettingsAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", LobbySettingsStorageKey);
            if (string.IsNullOrWhiteSpace(json))
            {
                return;
            }

            if (json.Length > MaxLobbySettingsLength)
            {
                await RemoveInvalidLobbySettingsAsync();
                return;
            }

            var settings = System.Text.Json.JsonSerializer.Deserialize<PersistedLobbySettings>(json);
            if (settings?.Version != LobbySettingsSchemaVersion)
            {
                return;
            }

            ApplyLobbySettings(settings);
        }
        catch (Microsoft.JSInterop.JSException)
        {
            _settingsStorageAvailable = false;
        }
        catch (System.Text.Json.JsonException)
        {
            await RemoveInvalidLobbySettingsAsync();
        }
        catch (NotSupportedException)
        {
            await RemoveInvalidLobbySettingsAsync();
        }
    }

    private async Task SaveLobbySettingsAsync()
    {
        if (!_settingsLoaded || !_settingsStorageAvailable)
        {
            return;
        }

        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(CaptureLobbySettings());
            await JS.InvokeVoidAsync("localStorage.setItem", LobbySettingsStorageKey, json);
        }
        catch (Microsoft.JSInterop.JSException)
        {
            _settingsStorageAvailable = false;
        }
        catch (NotSupportedException)
        {
            _settingsStorageAvailable = false;
        }
    }

    private PersistedLobbySettings CaptureLobbySettings() => new()
    {
        Version = LobbySettingsSchemaVersion,
        TargetCrowns = _targetCrowns,
        CrateDensity = _crateDensity,
        ItemDropChance = _itemDropChance,
        Slots = _slots.Select(slot => (PersistedSlotSettings?)new PersistedSlotSettings
        {
            Name = slot.Name,
            Mode = slot.Mode.ToString(),
            Difficulty = slot.Difficulty.ToString()
        }).ToList()
    };

    private void ApplyLobbySettings(PersistedLobbySettings settings)
    {
        if (settings.TargetCrowns is 1 or 2 or 3 or 5)
        {
            _targetCrowns = settings.TargetCrowns;
        }

        _crateDensity = AllowedDouble(settings.CrateDensity, _crateDensity, .46, .60, .72);
        _itemDropChance = AllowedDouble(settings.ItemDropChance, _itemDropChance, .30, .52, .76);

        var savedSlots = settings.Slots ?? [];
        for (var index = 0; index < Math.Min(_slots.Count, savedSlots.Count); index++)
        {
            var saved = savedSlots[index];
            if (saved is null)
            {
                continue;
            }

            var slot = _slots[index];
            if (saved.Name is not null)
            {
                slot.Name = saved.Name[..Math.Min(saved.Name.Length, 16)];
            }

            if (Enum.TryParse<SlotMode>(saved.Mode, ignoreCase: true, out var mode) && Enum.IsDefined(mode))
            {
                slot.Mode = mode;
            }

            if (Enum.TryParse<AiDifficulty>(saved.Difficulty, ignoreCase: true, out var difficulty) && Enum.IsDefined(difficulty))
            {
                slot.Difficulty = difficulty;
            }
        }
    }

    private async Task RemoveInvalidLobbySettingsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", LobbySettingsStorageKey);
        }
        catch (Microsoft.JSInterop.JSException)
        {
            _settingsStorageAvailable = false;
        }
        catch (NotSupportedException)
        {
            _settingsStorageAvailable = false;
        }
    }

    private static double AllowedDouble(double value, double fallback, params double[] allowed) =>
        allowed.Any(candidate => Math.Abs(candidate - value) < .0001) ? value : fallback;

    private async Task RunGameLoopAsync(CancellationToken cancellationToken)
    {
        var last = _clock.Elapsed.TotalSeconds;
        // The engine advances on its own deterministic 60 Hz fixed step. Rendering at
        // 30 Hz keeps the SVG arena smooth, while TickInteractive discards time lost to
        // a blocked browser UI thread so bombs never catch up while input was impossible.
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(33));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                var now = _clock.Elapsed.TotalSeconds;
                var elapsed = now - last;
                last = now;
                if (_inLobby || _session.Phase != GamePhase.Playing)
                {
                    continue;
                }

                ApplyHumanControls();
                _session.TickInteractive(elapsed);
                _snapshot = _session.Snapshot;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private void ApplyHumanControls()
    {
        var humanIndex = 0;
        foreach (var player in _snapshot.Players)
        {
            if (player.Kind != PlayerKind.Human)
            {
                continue;
            }

            var scheme = ControlSchemes[Math.Min(humanIndex, ControlSchemes.Length - 1)];
            var horizontal = Axis(scheme.Left, scheme.Right);
            var vertical = Axis(scheme.Up, scheme.Down);
            _session.SetControls(player.Id, new PlayerControls(horizontal, vertical, _heldKeys.Contains(scheme.Bomb), _heldKeys.Contains(scheme.Action)));
            humanIndex++;
        }
    }

    private double Axis(string negative, string positive) => (_heldKeys.Contains(positive) ? 1 : 0) - (_heldKeys.Contains(negative) ? 1 : 0);

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (!string.IsNullOrEmpty(args.Code))
        {
            _heldKeys.Add(args.Code);
        }

        if (args.Code == "Escape" && !args.Repeat)
        {
            TogglePause();
        }
    }

    private void OnKeyUp(KeyboardEventArgs args)
    {
        if (!string.IsNullOrEmpty(args.Code))
        {
            _heldKeys.Remove(args.Code);
        }
    }

    private void TogglePause()
    {
        if (_session.Phase == GamePhase.Playing)
        {
            _session.Pause();
        }
        else if (_session.Phase == GamePhase.Paused)
        {
            _session.Resume();
        }

        _snapshot = _session.Snapshot;
    }

    private async Task ResumeAsync()
    {
        _session.Resume();
        _snapshot = _session.Snapshot;
        _focusArenaAfterRender = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task NextRoundAsync()
    {
        _session.StartNextRound();
        _snapshot = _session.Snapshot;
        _heldKeys.Clear();
        _focusArenaAfterRender = true;
        await InvokeAsync(StateHasChanged);
    }

    private void ReturnToLobby()
    {
        _inLobby = true;
        _heldKeys.Clear();
        _showHelp = false;
        _showExitFallback = false;
    }

    private async Task RequestExitAsync()
    {
        if (_isExiting || !_inLobby || !_settingsLoaded)
        {
            return;
        }

        _isExiting = true;
        _showHelp = false;
        _showExitFallback = false;

        try
        {
            var settingsJson = System.Text.Json.JsonSerializer.Serialize(CaptureLobbySettings());
            var windowIsStillOpen = await JS.InvokeAsync<bool>(
                "neonBomberWindow.tryClose",
                LobbySettingsStorageKey,
                settingsJson);

            if (windowIsStillOpen)
            {
                _isExiting = false;
                _showExitFallback = true;
            }
        }
        catch (Microsoft.JSInterop.JSException)
        {
            ShowExitFallback();
        }
        catch (InvalidOperationException)
        {
            ShowExitFallback();
        }
        catch (OperationCanceledException)
        {
            ShowExitFallback();
        }
    }

    private void ShowExitFallback()
    {
        _isExiting = false;
        _showExitFallback = true;
    }

    private void HideExitFallback() => _showExitFallback = false;
    private void ShowHelp()
    {
        _showExitFallback = false;
        _showHelp = true;
    }
    private void HideHelp() => _showHelp = false;

    private static string PlayerStyle(string color) => $"--player:{color}";
    private static string ChipStyle(string color) => $"--chip:{color}";
    private static string CellTransform(GridPosition cell) => $"translate({cell.X * CellSize + CellSize / 2} {cell.Y * CellSize + CellSize / 2})";
    private static string ItemTransform(ItemSnapshot item) => FormattableString.Invariant($"translate({item.X * CellSize:F2} {item.Y * CellSize:F2})");
    private static string PlayerTransform(PlayerSnapshot player) => FormattableString.Invariant($"translate({player.X * CellSize:F2} {player.Y * CellSize:F2})");
    private static string BombTransform(BombSnapshot bomb)
    {
        var lift = bomb.IsAirborne
            ? Math.Sin(Math.Clamp(bomb.AirborneProgress, 0, 1) * Math.PI) * CellSize * 1.15
            : 0;
        return FormattableString.Invariant($"translate({bomb.X * CellSize:F2} {bomb.Y * CellSize - lift:F2})");
    }

    private static double BombDashOffset(BombSnapshot bomb) =>
        Math.Clamp(100 - bomb.FuseSeconds / bomb.InitialFuseSeconds * 100, 0, 100);
    private string PlayerColor(int playerId) => _snapshot.Players.FirstOrDefault(player => player.Id == playerId)?.Color ?? "#ffffff";

    private string PlayerStatus(PlayerSnapshot player)
    {
        if (player.IsGhost)
        {
            if (player.Kind == PlayerKind.Computer)
            {
                var intent = player.IsGhostBombReady ? GhostAiIntent(player.AiIntent) : "等待";
                return $"AI 幽靈 · {DifficultyName(player.Difficulty)} · {intent}";
            }

            return $"真人幽靈 · {GhostBombLongStatus(player)}";
        }

        if (!player.IsAlive)
        {
            return "已退出本回合";
        }

        if (player.FrozenSeconds > 0)
        {
            return "零度凍結";
        }

        return player.Kind == PlayerKind.Computer
            ? $"{DifficultyLabel(player.Difficulty)} · {player.AiIntent}"
            : "真人操控 · ONLINE";
    }

    private string GhostBombLongStatus(PlayerSnapshot player)
    {
        if (player.IsGhostBombReady)
        {
            return "可投爆彈";
        }

        var bomb = ActiveGhostBomb(player.Id);
        return bomb?.IsAirborne == true ? "爆彈飛行中" : "等待爆破";
    }

    private string GhostBombShortStatus(PlayerSnapshot player)
    {
        if (player.IsGhostBombReady)
        {
            return "就緒";
        }

        return ActiveGhostBomb(player.Id)?.IsAirborne == true ? "飛行" : "等待";
    }

    private BombSnapshot? ActiveGhostBomb(int playerId) =>
        _snapshot.Bombs.FirstOrDefault(bomb => bomb.OwnerPlayerId == playerId && bomb.IsGhost);

    private static string DifficultyName(AiDifficulty difficulty) => difficulty switch
    {
        AiDifficulty.Novice => "新手",
        AiDifficulty.Expert => "高手",
        _ => "標準"
    };

    private static string GhostAiIntent(string intent)
    {
        if (intent.Contains("追蹤", StringComparison.Ordinal) || intent.Contains("track", StringComparison.OrdinalIgnoreCase) || intent.Contains("hunt", StringComparison.OrdinalIgnoreCase))
        {
            return "追蹤";
        }

        if (intent.Contains("伏擊", StringComparison.Ordinal) || intent.Contains("ambush", StringComparison.OrdinalIgnoreCase))
        {
            return "伏擊";
        }

        if (intent.Contains("等待", StringComparison.Ordinal) || intent.Contains("wait", StringComparison.OrdinalIgnoreCase))
        {
            return "等待";
        }

        return "待命";
    }

    private static string FacingArrow(PlayerSnapshot player) =>
        player.FacingY < 0 ? "↑" : player.FacingY > 0 ? "↓" : player.FacingX < 0 ? "←" : "→";

    private static string GhostDirectionPath(PlayerSnapshot player)
    {
        var x = player.FacingX;
        var y = player.FacingY;
        var startX = x * 19 - y * 5;
        var startY = y * 19 + x * 5;
        var tipX = x * 26;
        var tipY = y * 26;
        var endX = x * 19 + y * 5;
        var endY = y * 19 - x * 5;
        return $"M{startX} {startY} L{tipX} {tipY} L{endX} {endY}";
    }

    private IEnumerable<GridPosition> GhostLandingCells(PlayerSnapshot player)
    {
        if (!player.IsGhost || !player.IsGhostBombReady)
        {
            yield break;
        }

        var board = _snapshot.Board;
        IEnumerable<GridPosition> candidates;
        if (player.FacingX == 0 && player.FacingY > 0 && player.Y < 1)
        {
            var x = Math.Clamp((int)Math.Floor(player.X), 1, board.Width - 2);
            candidates = Enumerable.Range(1, board.Height - 2).Select(y => new GridPosition(x, y));
        }
        else if (player.FacingX == 0 && player.FacingY < 0 && player.Y > board.Height - 1)
        {
            var x = Math.Clamp((int)Math.Floor(player.X), 1, board.Width - 2);
            candidates = Enumerable.Range(1, board.Height - 2).Reverse().Select(y => new GridPosition(x, y));
        }
        else if (player.FacingX > 0 && player.FacingY == 0 && player.X < 1)
        {
            var y = Math.Clamp((int)Math.Floor(player.Y), 1, board.Height - 2);
            candidates = Enumerable.Range(1, board.Width - 2).Select(x => new GridPosition(x, y));
        }
        else if (player.FacingX < 0 && player.FacingY == 0 && player.X > board.Width - 1)
        {
            var y = Math.Clamp((int)Math.Floor(player.Y), 1, board.Height - 2);
            candidates = Enumerable.Range(1, board.Width - 2).Reverse().Select(x => new GridPosition(x, y));
        }
        else
        {
            yield break;
        }

        foreach (var cell in candidates)
        {
            if (board[cell] == TileType.Floor && !_snapshot.Bombs.Any(bomb => bomb.Cell == cell))
            {
                yield return cell;
            }
        }
    }

    private static string DifficultyLabel(AiDifficulty difficulty) => difficulty switch
    {
        AiDifficulty.Novice => "新手 AI",
        AiDifficulty.Expert => "高手 AI",
        _ => "標準 AI"
    };

    private static IEnumerable<PowerUpDefinition> ActivePowers(PlayerSnapshot player)
    {
        if (player.BombCapacity > 1) yield return PowerUpCatalog.Get(PowerUpKind.BombCapacity);
        if (player.FireRange > 1) yield return PowerUpCatalog.Get(PowerUpKind.FireRange);
        if (player.MoveSpeed > 3.16) yield return PowerUpCatalog.Get(PowerUpKind.Speed);
        if (player.CanKick) yield return PowerUpCatalog.Get(PowerUpKind.Kick);
        if (player.HasGlove) yield return PowerUpCatalog.Get(PowerUpKind.Glove);
        if (player.HasRemote) yield return PowerUpCatalog.Get(PowerUpKind.Remote);
        if (player.HasBrickDisguise) yield return PowerUpCatalog.Get(PowerUpKind.BrickDisguise);
        if (player.HasPiercingFlames) yield return PowerUpCatalog.Get(PowerUpKind.Pierce);
        if (player.CanPassBombs) yield return PowerUpCatalog.Get(PowerUpKind.BombPass);
        if (player.CanPassCrates) yield return PowerUpCatalog.Get(PowerUpKind.WallPass);
        if (player.IsFlameproof) yield return PowerUpCatalog.Get(PowerUpKind.FlamePass);
        if (player.Shield > 0) yield return PowerUpCatalog.Get(PowerUpKind.Shield);
        if (player.Health > 1) yield return PowerUpCatalog.Get(PowerUpKind.Heart);
        if (player.DashCharges > 0) yield return PowerUpCatalog.Get(PowerUpKind.Dash);
        if (player.MegaCharges > 0) yield return PowerUpCatalog.Get(PowerUpKind.Mega);
        if (player.ClusterCharges > 0) yield return PowerUpCatalog.Get(PowerUpKind.Cluster);
        if (player.FrozenSeconds > 0) yield return PowerUpCatalog.Get(PowerUpKind.Freeze);
        if (player.HasMagnet) yield return PowerUpCatalog.Get(PowerUpKind.Magnet);
    }

    public async ValueTask DisposeAsync()
    {
        _loopCancellation.Cancel();
        if (_loopTask is not null)
        {
            try { await _loopTask; }
            catch (OperationCanceledException) { }
        }
        _loopCancellation.Dispose();
    }

    private enum SlotMode { Human, Computer, Off }
    private sealed class SlotEditor(string name, SlotMode mode, AiDifficulty difficulty, string color)
    {
        public string Name { get; set; } = name;
        public SlotMode Mode { get; set; } = mode;
        public AiDifficulty Difficulty { get; set; } = difficulty;
        public string Color { get; } = color;
    }

    private sealed class PersistedLobbySettings
    {
        public int Version { get; set; }
        public int TargetCrowns { get; set; }
        public double CrateDensity { get; set; }
        public double ItemDropChance { get; set; }
        public List<PersistedSlotSettings?>? Slots { get; set; }
    }

    private sealed class PersistedSlotSettings
    {
        public string? Name { get; set; }
        public string? Mode { get; set; }
        public string? Difficulty { get; set; }
    }

    private sealed record ControlScheme(string Left, string Right, string Up, string Down, string Bomb, string Action);
}
